# Copie para .env antes de iniciar o servidor.
# Windows: Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env

PORT=3000

# Substitua por valores próprios. JWT_SECRET precisa ter pelo menos 32 caracteres
# e não pode manter o texto de exemplo abaixo.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barber_select

# Habilita a criação das contas iniciais em um banco vazio.
ALLOW_DEFAULT_SEED=true
SEED_ADMIN_PASSWORD=AdminPassword2026!
